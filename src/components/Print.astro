---
import { company, customer, docs, lines, subtotal, cgst, sgst, total, inr, inWords } from '../data/sample';

const themes = [
  { id: 'classic', label: 'Classic' },
  { id: 'blue', label: 'Professional Blue' },
  { id: 'green', label: 'Executive Green' },
];
---

<section class="sheet print" id="print" data-nav="light" data-chapter="No. 06 · Printing" aria-labelledby="print-title">
  <span class="perf" aria-hidden="true" style="--hole: var(--triplicate)"></span>
  <div class="stub" aria-hidden="true"><span class="serial">No. 06 · Original</span></div>

  <div class="sheet-inner">
    <h2 class="display-l print-title" id="print-title" data-reveal="mask">Print it your company’s way.</h2>
  <div class="layout">
    <div class="copy">
      <p class="lede" data-reveal style="--i: 2">
        Quotations, purchase orders, delivery notes and stock transfers print in one of three
        designs, chosen per company. The design changes; the GST, totals and amount in words do
        not. Invoices always print in the statutory boxed GST format.
      </p>

      <fieldset class="themes" data-reveal style="--i: 3">
        <legend>Try a design</legend>
        {
          themes.map((t, i) => (
            <label>
              <input type="radio" name="pdf-theme" id={`pdf-${t.id}`} value={t.id} checked={i === 0} />
              <span class={`swatch sw-${t.id}`} aria-hidden="true" />
              {t.label}
            </label>
          ))
        }
      </fieldset>

      <p class="rule" data-reveal style="--i: 4">
        The address block prints exactly as it reads on the form, GSTIN and place of supply included.
        Nothing is appended behind your back.
      </p>
    </div>

    <div class="stage" data-reveal style="--i: 1">
      <div class="under u2" aria-hidden="true"></div>
      <div class="under u1" aria-hidden="true"></div>
      <article class="pdf" aria-label={`Quotation ${docs.quotation} as a printed PDF, illustrative`}>
        <header class="p-head">
          <div class="p-co">
            <p class="p-name">{company.name}</p>
            <p class="p-sm">Plot 22, Chandaka Industrial Estate, {company.city}</p>
            <p class="p-sm">GSTIN {company.gstin} · State Odisha, Code 21</p>
          </div>
          <div class="p-title">
            <p class="p-doc">Quotation</p>
            <p class="p-no">{docs.quotation}</p>
            <p class="p-sm">Date 08 Sep 2026 · Valid till 23 Sep 2026</p>
          </div>
        </header>
        <div class="p-accent" aria-hidden="true"><span></span></div>

        <div class="p-parties">
          <div class="p-box">
            <p class="p-label">Bill to</p>
            <p class="p-strong">{customer.name}</p>
            <p class="p-sm">Link Road, {customer.city}</p>
            <p class="p-sm">GSTIN 21PQRSX5678K1Z2</p>
            <p class="p-sm">Place of supply: Odisha</p>
          </div>
          <div class="p-box">
            <p class="p-label">Kind attention</p>
            <p class="p-strong">{customer.contact}</p>
            <p class="p-sm">Supply type: Intra-state (CGST + SGST)</p>
          </div>
        </div>

        <table class="p-items">
          <thead>
            <tr><th scope="col">#</th><th scope="col">Description</th><th scope="col">HSN</th><th scope="col" class="r">Qty</th><th scope="col" class="r">Rate</th><th scope="col" class="r">Amount</th></tr>
          </thead>
          <tbody>
            {lines.map((l, i) => (
              <tr><td>{i + 1}</td><td>{l.item}</td><td>{l.hsn}</td><td class="r">{l.qty} {l.unit}</td><td class="r">{inr(l.rate, 2)}</td><td class="r">{inr(l.amount, 2)}</td></tr>
            ))}
          </tbody>
        </table>

        <div class="p-bottom">
          <div class="p-words">
            <p class="p-label">Amount in words</p>
            <p>{inWords(total)}</p>
            <p class="p-label p-gap">Terms</p>
            <p class="p-sm">Prices ex-godown Bhubaneswar. Delivery within 7 days of order.</p>
          </div>
          <dl class="p-totals">
            <div><dt>Taxable value</dt><dd>{inr(subtotal, 2)}</dd></div>
            <div><dt>CGST 9%</dt><dd>{inr(cgst, 2)}</dd></div>
            <div><dt>SGST 9%</dt><dd>{inr(sgst, 2)}</dd></div>
            <div class="p-grand"><dt>Total</dt><dd>₹{inr(total, 2)}</dd></div>
          </dl>
        </div>

        <footer class="p-foot">
          <span>For {company.name}</span>
          <span class="p-sign">Authorised signatory</span>
        </footer>
        <p class="p-gen">Generated by FlowX365 · Page 1 of 1 · Illustrative data</p>
      </article>
    </div>
  </div>
  </div>
</section>

<style>
  .print {
    padding: var(--section) 0;
    overflow-x: clip;
  }

  .print-title {
    max-width: 14ch;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: center;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .copy .lede {
    color: var(--ink-2);
  }

  .themes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    border: 0;
  }

  .themes legend {
    width: 100%;
    margin-bottom: 0.85rem;
    font-weight: 700;
  }

  .themes input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .themes label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0 1.1rem 0 0.9rem;
    border: 1.5px solid var(--rule-strong);
    border-radius: var(--radius-ui);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 140ms var(--ease-out);
  }

  .themes label:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .themes label:hover {
      border-color: var(--ink);
    }
  }

  .themes label:has(input:checked) {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--original);
  }

  .themes label:has(input:focus-visible) {
    outline: 2px solid var(--live);
    outline-offset: 3px;
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
  }

  .sw-classic {
    background: linear-gradient(135deg, #1a2340 55%, #f5820a 55%);
  }
  .sw-blue {
    background: #2456a6;
  }
  .sw-green {
    background: #1e7a46;
  }

  .rule {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--rule-strong);
    color: var(--ink-2);
    max-width: 34em;
  }

  /* ── The printed page ─────────────────────────────────────── */
  .stage {
    position: relative;
    padding: 1rem 1.5rem 1.5rem 0;
  }

  .under {
    position: absolute;
    inset: 1rem 1.5rem 1.5rem 0;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 10px 30px -12px rgb(15 21 32 / 0.3);
  }

  .u1 {
    transform: rotate(2.2deg) translate(10px, 6px);
  }

  .u2 {
    transform: rotate(4.5deg) translate(20px, 14px);
  }

  .pdf {
    --acc: #1a2340;
    --acc-2: #f5820a;
    --acc-ink: #fff;
    --head-bg: #1a2340;
    --tint: #f3f5f9;
    position: relative;
    background: #fff;
    color: #1f2937;
    padding: clamp(1.1rem, 2.4vw, 2rem);
    border-radius: 2px;
    box-shadow:
      0 1px 2px rgb(15 21 32 / 0.12),
      0 30px 60px -24px rgb(15 21 32 / 0.45);
    font-size: clamp(9.5px, 0.55rem + 0.25vw, 12px);
    line-height: 1.45;
    font-variation-settings: 'wdth' 100;
  }

  .pdf *,
  .pdf {
    transition:
      background-color 450ms var(--ease-in-out),
      color 450ms var(--ease-in-out),
      border-color 450ms var(--ease-in-out);
  }

  .p-head {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1em 1.3em;
    background: var(--head-bg);
    color: var(--acc-ink);
    margin: -0.25em -0.25em 0;
  }

  .p-name {
    font-weight: 800;
    font-size: 1.45em;
    letter-spacing: -0.01em;
    font-variation-settings: 'wdth' 110;
  }

  .p-sm {
    font-size: 0.92em;
    opacity: 0.85;
  }

  .p-title {
    text-align: right;
  }

  .p-doc {
    font-weight: 800;
    font-size: 1.7em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 125;
    color: var(--acc-2);
    line-height: 1.1;
  }

  .p-no {
    font-family: var(--mono);
    font-size: 1em;
    margin: 0.2em 0;
  }

  .p-accent {
    height: 3px;
    background: var(--acc-2);
    margin: 0 -0.25em;
  }

  .p-accent span {
    display: none;
  }

  .p-parties {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 0.9em;
    margin-top: 1.2em;
  }

  .p-box {
    border: 1px solid #d5dae3;
    padding: 0.8em 0.9em;
  }

  .p-label {
    font-size: 0.82em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--acc);
    margin-bottom: 0.2em;
  }

  .p-gap {
    margin-top: 0.9em;
  }

  .p-strong {
    font-weight: 700;
  }

  .p-items {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.2em;
  }

  .p-items th {
    background: var(--acc);
    color: #fff;
    text-align: left;
    font-weight: 700;
    font-size: 0.86em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.6em 0.7em;
  }

  .p-items td {
    padding: 0.6em 0.7em;
    border-bottom: 1px solid #e5e8ef;
  }

  .p-items tbody tr:nth-child(even) td {
    background: var(--tint);
  }

  .p-items .r {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .p-bottom {
    display: grid;
    grid-template-columns: 1fr minmax(0, 17em);
    gap: 1.5em;
    margin-top: 1.1em;
  }

  .p-words p:not(.p-label) {
    font-style: italic;
  }

  .p-totals {
    border: 1px solid #d5dae3;
  }

  .p-totals div {
    display: flex;
    justify-content: space-between;
    padding: 0.45em 0.8em;
    font-variant-numeric: tabular-nums;
  }

  .p-grand {
    background: var(--acc);
    color: #fff;
    font-weight: 800;
    font-size: 1.15em;
  }

  .p-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 2.4em;
    font-weight: 600;
  }

  .p-sign {
    border-top: 1px solid #9ca3af;
    padding-top: 0.3em;
    min-width: 12em;
    text-align: center;
    font-weight: 500;
  }

  .p-gen {
    margin-top: 1.4em;
    font-size: 0.82em;
    color: #9ca3af;
    text-align: center;
  }

  /* Professional Blue: letterhead, no boxes, a short heavy accent over a hairline. */
  .print:has(#pdf-blue:checked) .pdf {
    --acc: #2456a6;
    --acc-2: #2456a6;
    --acc-ink: #1f2937;
    --head-bg: #fff;
    --tint: #f5f8fd;
  }

  .print:has(#pdf-blue:checked) .p-name,
  .print:has(#pdf-green:checked) .p-name {
    color: var(--acc);
  }

  .print:has(#pdf-blue:checked) .p-doc {
    color: #1b3f7d;
  }

  .print:has(:is(#pdf-blue, #pdf-green):checked) .p-accent {
    height: 1px;
    background: #d5dae3;
    position: relative;
  }

  .print:has(:is(#pdf-blue, #pdf-green):checked) .p-accent span {
    display: block;
    position: absolute;
    left: 1.3em;
    top: -2px;
    width: 4.5em;
    height: 4px;
    background: var(--acc);
  }

  .print:has(:is(#pdf-blue, #pdf-green):checked) .p-box {
    border-color: transparent;
    padding-left: 0;
  }

  .print:has(:is(#pdf-blue, #pdf-green):checked) .p-items th {
    background: color-mix(in srgb, var(--acc) 9%, white);
    color: var(--acc);
    border-bottom: 1.5px solid var(--acc);
  }

  .print:has(:is(#pdf-blue, #pdf-green):checked) .p-totals {
    border: 0;
    border-left: 3px solid var(--acc);
  }

  .print:has(:is(#pdf-blue, #pdf-green):checked) .p-grand {
    background: color-mix(in srgb, var(--acc) 10%, white);
    color: var(--acc);
  }

  /* Executive Green: the same letterhead, mirrored. */
  .print:has(#pdf-green:checked) .pdf {
    --acc: #1e7a46;
    --acc-2: #155c34;
    --acc-ink: #1f2937;
    --head-bg: #fff;
    --tint: #f4faf6;
  }

  .print:has(#pdf-green:checked) .p-head {
    flex-direction: row-reverse;
  }

  .print:has(#pdf-green:checked) .p-title {
    text-align: left;
  }

  .print:has(#pdf-green:checked) .p-co {
    text-align: right;
  }

  .print:has(#pdf-green:checked) .p-accent span {
    left: auto;
    right: 1.3em;
  }

  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .p-items th:nth-child(3),
    .p-items td:nth-child(3),
    .p-items th:nth-child(5),
    .p-items td:nth-child(5) {
      display: none;
    }
    .p-parties,
    .p-bottom {
      grid-template-columns: 1fr;
    }
    .p-head {
      flex-direction: column;
      gap: 0.8em;
    }
    .print:has(#pdf-green:checked) .p-head {
      flex-direction: column-reverse;
    }
    .p-title,
    .print:has(#pdf-green:checked) .p-co {
      text-align: left;
    }
    .stage {
      padding: 0.5rem 0.5rem 0.75rem 0;
    }
    .under {
      inset: 0.5rem 0.5rem 0.75rem 0;
    }
    .u1 {
      transform: rotate(1deg) translate(3px, 3px);
    }
    .u2 {
      transform: rotate(1.8deg) translate(6px, 5px);
    }
    .themes label {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
