---
import Icon from './ui/Icon.astro';
import { site } from '../data/site';

const faqs = [
  {
    q: 'Where does FlowX365 run?',
    a: `In the browser at app.flowx365.com, and as an Android app.`,
  },
  {
    q: 'How do people sign in?',
    a: 'With an email and password, or with Google. Accounts are created by your administrator, so nobody outside your business can sign up to it.',
  },
  {
    q: 'Does it handle GST?',
    a: 'Documents carry HSN codes and split tax into CGST and SGST, or IGST for inter-state supply, with the amount in words. Invoices print in the statutory boxed GST format.',
  },
  {
    q: 'Can we get our data out?',
    a: 'List screens export what they show to Excel or CSV, and documents print to PDF.',
  },
  {
    q: 'Does it work with attendance machines?',
    a: 'It receives punches from an eSSL X2008 biometric terminal. Half days are worked out at 21:00 every night, and approved field visits count as full days.',
  },
  {
    q: 'Can it send emails for us?',
    a: 'The planner sends a 07:30 agenda, reminders before meetings and an evening digest of anything overdue. The wording of each email is editable in settings.',
  },
  {
    q: 'Can we have more than one warehouse?',
    a: 'Yes. Stock is tracked per warehouse, with transfers between them, and every item shows its breakdown by location.',
  },
  {
    q: 'Who makes FlowX365?',
    a: `${site.maker}.`,
  },
];
---

<section class="sheet details" id="details" data-copy="triplicate" data-nav="light" data-chapter="No. 09 · Details" aria-labelledby="details-title">
  <span class="perf" aria-hidden="true" style="--hole: var(--duplicate)"></span>
  <div class="stub" aria-hidden="true"><span class="serial">No. 09 · Triplicate</span></div>

  <div class="sheet-inner layout">
    <h2 class="display-l" id="details-title" data-reveal="mask">The details.</h2>

    <div class="list">
      {
        faqs.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <Icon name="chevron" size={20} />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .details {
    padding: var(--section) 0;
    position: relative;
    z-index: 1;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2.5rem clamp(2rem, 6vw, 7rem);
    align-items: start;
  }

  .layout .display-l {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
  }

  .list {
    border-top: 2px solid var(--ink);
  }

  details {
    border-bottom: 1px solid var(--rule-strong);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4rem;
    padding: 1.1rem 0;
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex: none;
    transition: transform 250ms var(--ease-out);
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  details p {
    padding: 0 0 1.5rem;
    max-width: 38em;
    color: var(--ink-2);
    font-size: var(--step-0);
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 300ms var(--ease-out),
      content-visibility 300ms allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  :root {
    interpolate-size: allow-keywords;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .layout .display-l {
      position: static;
    }
  }
</style>
